# Copy this file to .env

# JDE orchestrator tokens are minted by this server itself (see auth.py): 
# each user signs in with their JDE username/password via a browser login prompt 
# when they connect, and the server exchanges that for an orchestrator token behind 
# the scenes. ORCH_TOKEN_URL is the base used for that tokenrequest call. Note it's
# a different base path than ORCH_URL.

ORCH_URL=http://vpn03.mrad-services.com:5010/jderest/orchestrator
ORCH_ADDRESS_ENDPOINT=/ORCHI_MCP_AddressBook
ORCH_TOKEN_URL=http://vpn03.mrad-services.com:5010/jderest

# JDE environment to authenticate against when minting a token. Not a
# secret. JDV920 is Oracle JDE's name for the test environment.
ORCH_ENVIRONMENT=JDV920

# Public HTTPS URL this server is reachable at (used to build OAuth
# authorize/token/login URLs). See the "Connecting a client" step in
# README.md for where this value comes from.
PUBLIC_BASE_URL=https://mcpserver.mrad-services.com:555

# auth.py tunables (see the "Attributes" section of JdeOAuthProvider's
# docstring for what each one controls).
AUTH_CODE_TTL_SECONDS=300
PENDING_LOGIN_TTL_SECONDS=300
JDE_TOKEN_TTL_SECONDS=3300
MAX_LOGIN_ATTEMPTS_PER_PENDING=5